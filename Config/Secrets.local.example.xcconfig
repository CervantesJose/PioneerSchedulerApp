// TEMPLATE — copy this file to `Secrets.local.xcconfig` (same folder) and fill in
// the real values. `Secrets.local.xcconfig` is gitignored and must never be committed.
//
// Values come from the Supabase dashboard → Project Settings → API.
// Only the `anon` (public) key belongs here — never the `service_role` key.
//
// NOTE: the `/$()/` between `https:` and the host escapes the `//` so the xcconfig
// parser does not treat the rest of the line as a comment. Keep it.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
